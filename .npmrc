# GitHub Packages hosts the @anilkumar1510 scope. The token is read from the
# environment on purpose — never commit it here.
#   Needs a classic PAT with write:packages (read:packages to install).
#   PowerShell:  $env:NODE_AUTH_TOKEN = "ghp_..."
@anilkumar1510:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
