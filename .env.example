# OPD Wallet - Environment Configuration Example
#
# Copy to .env (or api/.env for the backend) and adjust.
# Variable names below are verified against api/src/config/configuration.ts and api/src/main.ts.
# Anything marked "NOT WIRED" is parsed into config but never read by the code — setting it
# has no effect today. Do not rely on those until they are hooked up.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
# API_PORT takes precedence over PORT
PORT=4000

# Skip AWS Secrets Manager and read secrets from this file.
# Secrets Manager is used automatically when NODE_ENV=production OR this is true.
USE_SECRETS_MANAGER=false

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# With auth (Docker default):
MONGODB_URI=mongodb://admin:admin123@localhost:27017/opd_wallet?authSource=admin
# Without auth (typical bare-metal local install):
# MONGODB_URI=mongodb://localhost:27017/opd_wallet

# Only used by the Docker mongo container on first initialisation
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=opd_wallet

# ---------------------------------------------------------------------------
# JWT & Session Cookie
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_in_production_use_strong_secret
# NOTE: the variable is JWT_EXPIRY, not JWT_EXPIRES_IN
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRY=30d

COOKIE_NAME=opd_session
COOKIE_MAX_AGE=604800000
# Defaults to true when NODE_ENV=production, false otherwise
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave unset for localhost; set to the shared domain in production
# COOKIE_DOMAIN=eliktron.com

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Only read when NODE_ENV=production. In development the API uses a hardcoded
# allowlist covering ports 3000-3006 (web portals) and 8081/8082/8083/19006 (Expo).
CORS_ORIGIN=https://eliktron.com
CORS_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Redis & Cache
# ---------------------------------------------------------------------------
# The API starts without Redis; cache reads simply miss.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Per-domain cache TTLs, in SECONDS (converted to milliseconds internally)
CACHE_TTL_PROFILE=600
CACHE_TTL_WALLET=300
CACHE_TTL_PLAN_CONFIG=1800
CACHE_TTL_CATEGORIES=3600

# ---------------------------------------------------------------------------
# Third-Party Services
# ---------------------------------------------------------------------------
# Daily.co powers video consultations (replaced Jitsi Meet)
DAILY_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Audit Logging (HIPAA)
# ---------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
# 730 days = 2 years, per HIPAA retention requirements
AUDIT_LOG_RETENTION_DAYS=730

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
MONITORING_ENABLED=false
DB_QUERY_TIMEOUT=5000
# DB_POOL_SIZE - NOT WIRED (parsed into config, never read)

# ---------------------------------------------------------------------------
# Frontend URLs
# ---------------------------------------------------------------------------
# Browser-side calls. Portals with a basePath must use an absolute API URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Server-side calls from Next.js (Docker: http://opd-api-prod:4000/api)
API_URL=http://localhost:4000/api

MEMBER_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001
DOCTOR_URL=http://localhost:3003
TPA_URL=http://localhost:3004
OPERATIONS_URL=http://localhost:3005
FINANCE_URL=http://localhost:3006

# React Native / Expo member portal (web-member-rn/.env)
# Use the machine's LAN IP instead of localhost when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SESSION_TIMEOUT_MINUTES=15

# ---------------------------------------------------------------------------
# NOT WIRED - rate limiting is hardcoded in api/src/main.ts
# ---------------------------------------------------------------------------
# Global limiter:  15 min window / 1000 requests per IP
# Auth limiter:    15 min window / 50 requests in production, 500 in development
# The following are parsed by configuration.ts but never consumed:
#   RATE_LIMIT_WINDOW, RATE_LIMIT_GLOBAL, RATE_LIMIT_AUTH, RATE_LIMIT_API
#   MAX_LOGIN_ATTEMPTS, LOCK_TIME
