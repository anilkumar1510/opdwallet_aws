{
  "name": "opd-wallet-angular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "NODE_OPTIONS=--disable-warning=DEP0060 OPD_WALLET_PUBLIC_PATH=http://localhost:4500 ng serve member --proxy-config proxy.conf.json",
    "build": "ng build member",
    "watch": "ng build member --watch --configuration development",
    "test": "ng test member",
    "test:e2e": "npx playwright test",
    "test:e2e:claims": "npx playwright test tests/e2e/claims --project=chromium --workers=1 --reporter=line",
    "test:e2e:claims:list": "npx playwright test tests/e2e/claims/claims-list.spec.ts --project=chromium --workers=1 --reporter=line",
    "lint": "ng lint",
    "pack:member": "ng build member && node tools/pack-member.mjs",
    "publish:member": "npm run pack:member && npm publish ./dist/member/browser",
    "demo": "playwright test --config playwright.demo.config.ts --project submit --project detail",
    "demo:dry": "DEMO_SLOTS=1 playwright test --config playwright.demo.config.ts --project submit -g \"asks for\"",
    "demo:submit": "playwright test --config playwright.demo.config.ts --project submit",
    "demo:detail": "playwright test --config playwright.demo.config.ts --project detail",
    "demo:status": "playwright test --config playwright.demo.config.ts --project status"
  },
  "dependencies": {
    "@angular-architects/module-federation": "^21.2.2",
    "@angular/common": "~21.2.19",
    "@angular/compiler": "~21.2.19",
    "@angular/core": "~21.2.19",
    "@angular/forms": "~21.2.19",
    "@angular/platform-browser": "~21.2.19",
    "@angular/router": "~21.2.19",
    "agora-rtc-sdk-ng": "^4.24.7",
    "crypto-js": "^4.2.0",
    "heic2any": "^0.0.4",
    "ngx-image-compress": "^18.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.1.0",
    "@angular/build": "~21.2.19",
    "@angular/cli": "~21.2.19",
    "@angular/compiler-cli": "~21.2.19",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/crypto-js": "^4.2.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0"
  }
}
