{
  "name": "opd-wallet-angular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "OPD_WALLET_PUBLIC_PATH=http://localhost:4590 ng serve member --proxy-config proxy.conf.json",
    "build": "ng build member",
    "watch": "ng build member --watch --configuration development",
    "test": "ng test member",
    "lint": "ng lint",
    "pack:member": "ng build member && node tools/pack-member.mjs",
    "publish:member": "npm run pack:member && npm publish ./dist/member/browser"
  },
  "dependencies": {
    "@angular-architects/module-federation": "^21.2.2",
    "@angular/common": "~21.2.19",
    "@angular/compiler": "~21.2.19",
    "@angular/core": "~21.2.19",
    "@angular/forms": "~21.2.19",
    "@angular/platform-browser": "~21.2.19",
    "@angular/router": "~21.2.19",
    "agora-rtc-sdk-ng": "^4.24.7",
    "crypto-js": "^4.2.0",
    "heic2any": "^0.0.4",
    "ngx-image-compress": "^18.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.1.0",
    "@angular/build": "~21.2.19",
    "@angular/cli": "~21.2.19",
    "@angular/compiler-cli": "~21.2.19",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/crypto-js": "^4.2.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0"
  }
}
