{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "946446ce-36e7-44ee-bf3e-d60c743fe546"
  },
  "newProjectRoot": "projects",
  "projects": {
    "shell-tpa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/shell-tpa",
      "sourceRoot": "projects/shell-tpa/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/shell-tpa/src/main.ts",
            "tsConfig": "projects/shell-tpa/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shell-tpa/public"
              }
            ],
            "styles": ["projects/shell-tpa/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "shell-tpa:build:production"
            },
            "development": {
              "buildTarget": "shell-tpa:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "member": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "projects/member",
      "sourceRoot": "projects/member/src",
      "prefix": "opd",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "allowedCommonJsDependencies": ["agora-rtc-sdk-ng"],
            "main": "projects/member/src/main.ts",
            "outputPath": "dist/member",
            "customWebpackConfig": {
              "path": "projects/member/webpack.config.js"
            },
            "index": "projects/member/src/index.html",
            "tsConfig": "projects/member/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/member/public"
              }
            ],
            "styles": ["projects/member/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/member/src/environments/environment.ts",
                  "with": "projects/member/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "port": 4590,
            "host": "0.0.0.0",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "member:build:production"
            },
            "development": {
              "buildTarget": "member:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "member:build:development"
          }
        },
        "serve-original": {
					"builder": "@angular-devkit/build-angular:dev-server",
					"options": {
						"buildTarget": "member:build:development",
						"host": "0.0.0.0",
						"proxyConfig": "proxy.conf.json",
						"port": 4590
					},
					"configurations": {
						"development": {
							"buildTarget": "core-ui:esbuild:development1"
						},
						"production": {
							"buildTarget": "core-ui:esbuild:production"
						}
					}
				}
      }
    }
  }
}
